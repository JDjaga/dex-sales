# GEMINI_API_KEY: Optional for AI-assisted note drafting inside Institutional Engagement Brief.
# Leave unset if AI note drafting is not enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional HMAC/session secret (in-memory random fallback used if unset).
SESSION_SECRET=

# ADMIN_PASSCODE: Optional initial Super Admin passcode override for first-run setup.
ADMIN_PASSCODE=

# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_FROM:
# Optional SMTP email configuration. Email actions remain disabled until configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CALENDAR_WEBHOOK_URL: Optional calendar invitation integration endpoint.
CALENDAR_WEBHOOK_URL=
